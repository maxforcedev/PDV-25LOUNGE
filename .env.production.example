# Production deployment contract. Export these public values in the deployment
# shell; create secret contents with Docker Swarm and never store them here.

# Environment and release. RELEASE_TAG is required by preflight and must be a
# full 40-character lowercase Git commit SHA.
ENVIRONMENT=production
# Replace before deployment; the preflight rejects non-SHA values.
RELEASE_TAG=replace-with-full-commit-sha
BACKEND_IMAGE=ghcr.io/maxforcedev/core-pdv-backend
FRONTEND_IMAGE=ghcr.io/maxforcedev/core-pdv-frontend
PLATFORM_ADMIN_IMAGE=ghcr.io/maxforcedev/core-pdv-platform-admin
STACK_NAME=corepdv
TRAEFIK_NETWORK=traefik_public

# Public domains. FRONTEND_URL is the canonical browser origin used in password
# reset and POS pairing links; it must be a real HTTPS origin in production.
API_DOMAIN=api.corepdv.com
FRONTEND_DOMAIN=corepdv.com
FRONTEND_URL=https://corepdv.com
PLATFORM_ADMIN_DOMAIN=admin.corepdv.com
ALLOWED_HOSTS=corepdv.com,api.corepdv.com,admin.corepdv.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://corepdv.com,https://admin.corepdv.com,https://*.corepdv.com
CORS_ALLOWED_ORIGINS=https://corepdv.com,https://admin.corepdv.com
TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

# PostgreSQL. Docker Swarm builds DATABASE_URL internally as
# postgresql://${POSTGRES_USER}@db:5432/${POSTGRES_DB}; do not set
# POSTGRES_HOST, POSTGRES_PORT, or DATABASE_URL for this deployment mode.
POSTGRES_DB=corepdv
POSTGRES_USER=corepdv
DATABASE_CONNECT_TIMEOUT=3

# Security and sessions. DEBUG, trusted proxy headers, HTTPS redirect, secure
# cookies, and content sniffing protection are enforced by docker-stack.yml.
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Keep HSTS reversible until VPS, DNS, HTTPS, and Traefik are validated.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Gunicorn and startup. MIGRATE_ON_START is safe only while backend has one replica.
MIGRATE_ON_START=True
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=5
GUNICORN_FORWARDED_ALLOW_IPS=*

# Docker Swarm secret names. The secret contents are mounted internally as:
# /run/secrets/django_secret_key, /run/secrets/postgres_password,
# /run/secrets/cielo_smart_client_id, and /run/secrets/cielo_smart_access_token.
DJANGO_SECRET_NAME=corepdv_django_secret_key
POSTGRES_PASSWORD_SECRET_NAME=corepdv_postgres_password
CIELO_SMART_CLIENT_ID_SECRET_NAME=corepdv_cielo_smart_client_id
CIELO_SMART_ACCESS_TOKEN_SECRET_NAME=corepdv_cielo_smart_access_token

# Cielo credentials are read exclusively from the two Docker secrets above.
# Never set CIELO_SMART_CLIENT_ID or CIELO_SMART_ACCESS_TOKEN in this file.

# SMTP is disabled by default. With SMTP_ENABLED=False, the base stack keeps
# Django's console backend and requires no SMTP secret.
SMTP_ENABLED=False
# Set all values below when SMTP_ENABLED=True and deploy docker-stack.smtp.yml.
# EMAIL_HOST_PASSWORD_FILE is fixed by that overlay to /run/secrets/smtp_password.
EMAIL_HOST=smtp.example.invalid
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-user
DEFAULT_FROM_EMAIL="CORE PDV <nao-responda@corepdv.com>"
SALES_LEAD_EMAIL=sales@example.invalid
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
SMTP_PASSWORD_SECRET_NAME=corepdv_smtp_password

# CORE POS runtime policy served by the backend. POS_API_BASE_URL is not a
# backend runtime variable: pass it to the Flutter release build with
# --dart-define=POS_API_BASE_URL=https://api.corepdv.com.
POS_CURRENT_VERSION=1.0.0
POS_LATEST_VERSION=1.0.0
POS_MINIMUM_SUPPORTED_VERSION=1.0.0
POS_OPERATOR_SESSION_MINUTES=480

# Frontend values are build-time arguments, not Swarm runtime variables. The
# current CI publishing workflow builds immutable images with these origins.
# Changing them requires changing the workflow/build arguments and rebuilding.
# NEXT_PUBLIC_API_URL=https://api.corepdv.com/api/v1
# NEXT_PUBLIC_BACKOFFICE_URL=https://corepdv.com
# NEXT_PUBLIC_CORE_TEASER_URL=/site/videos/core-teaser.mp4
# NEXT_PUBLIC_CORE_TEASER_POSTER_URL=/site/videos/core-teaser-poster.webp

# Optional release script inputs: SMTP_STACK_FILE=docker-stack.smtp.yml,
# RELEASE_WAIT_SECONDS=180, and BACKUP_FILE=<existing-backup-path>.
