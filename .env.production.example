# Public release configuration. Copy values to the deployment environment;
# never place real secret contents in this file.
DEBUG=False

DOMAIN=corepdv.com
API_DOMAIN=api.corepdv.com
FRONTEND_DOMAIN=corepdv.com
PLATFORM_ADMIN_DOMAIN=admin.corepdv.com

BACKEND_IMAGE=ghcr.io/maxforcedev/core-pdv-backend
FRONTEND_IMAGE=ghcr.io/maxforcedev/core-pdv-frontend
PLATFORM_ADMIN_IMAGE=ghcr.io/maxforcedev/core-pdv-platform-admin
RELEASE_TAG=<full-commit-sha>

# Release metadata is embedded in all images by CI from VERSION and the commit.
ENVIRONMENT=production

ALLOWED_HOSTS=corepdv.com,api.corepdv.com,admin.corepdv.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://corepdv.com,https://admin.corepdv.com,https://*.corepdv.com
CORS_ALLOWED_ORIGINS=https://corepdv.com,https://admin.corepdv.com

TIME_ZONE=America/Sao_Paulo
LANGUAGE_CODE=pt-br

POSTGRES_DB=corepdv
POSTGRES_USER=corepdv
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://corepdv@db:5432/corepdv
DATABASE_CONNECT_TIMEOUT=3

# These paths are mounted by Docker Swarm from external secrets.
SECRET_KEY_FILE=/run/secrets/django_secret_key
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# SECRET_KEY=<docker-secret:corepdv_django_secret_key>
# POSTGRES_PASSWORD=<docker-secret:corepdv_postgres_password>

TRUST_PROXY_HEADERS=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
# Idle sessions are renewed while active and expire after eight hours without requests.
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True
# Brute-force lockout combines normalized identity and trusted client origin.
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
CSRF_COOKIE_SECURE=True
SECURE_CONTENT_TYPE_NOSNIFF=True
# Django also sends a same-origin referrer policy and DENY frame policy.

# Keep HSTS reversible until DNS and HTTPS have been validated end to end.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Startup migration is allowed only while the backend has one replica.
MIGRATE_ON_START=True
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEP_ALIVE=5
# The proxy network is deployment-specific; do not narrow this without validating it.
GUNICORN_FORWARDED_ALLOW_IPS=*

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
PRIVATE_MEDIA_ROOT=/app/private_media

# Public browser URL consumed while building both frontend images, not at runtime.
NEXT_PUBLIC_API_URL=https://api.corepdv.com/api/v1
# Public Backoffice URL consumed while building the Platform Admin image.
NEXT_PUBLIC_BACKOFFICE_URL=https://corepdv.com
FRONTEND_URL=https://corepdv.com
DEFAULT_FROM_EMAIL=CORE PDV <nao-responda@corepdv.com>
